---
import Base from "../layouts/Base.astro";
import { site } from "../data/site";
import { services } from "../data/services";
---

<Base title="Contact — Valmark Waterproofing" activePage="contact">
  <!-- Hero -->
  <section class="bg-primary text-white py-16">
    <div class="max-w-[1200px] mx-auto px-6 text-center">
      <p
        class="text-accent-light uppercase tracking-wider font-bold text-sm mb-4"
      >
        Free Inspection
      </p>
      <h1 class="text-[clamp(34px,4.8vw,52px)] font-black leading-tight mb-6">
        Get In Touch With Waterproofing Specialists
      </h1>
    </div>
  </section>

  <!-- Content -->
  <section class="py-16">
    <div class="max-w-[1200px] mx-auto px-6 grid lg:grid-cols-2 gap-10">
      <!-- Left: contact form -->
      <div>
        <h2 class="text-2xl font-bold text-primary mb-6">Send Us A Message</h2>
        <form id="contact-form" class="flex flex-col gap-4">
          <input
            type="text"
            name="name"
            placeholder="Full name"
            required
            class="w-full border border-border-dark rounded px-4 py-3"
          />
          <input
            type="tel"
            name="phone"
            placeholder="Phone"
            required
            inputmode="tel"
            class="w-full border border-border-dark rounded px-4 py-3"
          />
          <input
            type="email"
            name="email"
            placeholder="Email"
            required
            class="w-full border border-border-dark rounded px-4 py-3"
          />
          <select
            name="service"
            class="w-full border border-border-dark rounded px-4 py-3 text-text-main"
          >
            <option value="">Select a service</option>
            {services.map((s) => <option value={s.id}>{s.name}</option>)}
          </select>
          <textarea
            name="message"
            placeholder="Tell us about your project"
            rows={5}
            class="w-full border border-border-dark rounded px-4 py-3 resize-y"
          ></textarea>
          <button
            type="submit"
            class="bg-accent text-white w-full py-4 font-bold uppercase tracking-wider rounded hover:opacity-90 transition-opacity cursor-pointer"
          >
            Book your inspection today
          </button>
        </form>
        <div id="contact-msg" class="mt-4 text-accent font-semibold"></div>
      </div>

      <!-- Right: map + info -->
      <div class="flex flex-col gap-6">
        <div
          class="bg-bg-light border border-border rounded h-64 flex items-center justify-center text-text-tertiary text-lg font-medium"
          style="background-image:repeating-linear-gradient(45deg,transparent,transparent 10px,rgba(0,0,0,.03) 10px,rgba(0,0,0,.03) 20px);"
        >
          Map placeholder
        </div>
        <div class="bg-white border border-border rounded p-6">
          <h3 class="font-bold text-lg text-primary mb-4">Contact Details</h3>
          <div class="flex flex-col gap-3 text-text-secondary">
            <div>
              <p
                class="font-semibold text-primary text-sm uppercase tracking-wider mb-1"
              >
                Hours
              </p>
              <p>Mon–Fri 7:00–6:00 · Sat 8:00–2:00</p>
              <p class="text-sm text-text-tertiary">
                Emergency dispatch any hour
              </p>
            </div>
            <div>
              <p
                class="font-semibold text-primary text-sm uppercase tracking-wider mb-1"
              >
                Email
              </p>
              <a
                href={`mailto:${site.email}`}
                class="text-accent hover:underline">{site.email}</a
              >
            </div>
            <div>
              <p
                class="font-semibold text-primary text-sm uppercase tracking-wider mb-1"
              >
                Phone
              </p>
              <a
                href={site.tel}
                class="text-accent font-bold text-xl hover:underline"
                >{site.phone}</a
              >
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  document.getElementById("contact-form")?.addEventListener("submit", (e) => {
    e.preventDefault();
    const msg = document.getElementById("contact-msg");
    if (msg)
      msg.textContent =
        "Thanks — a technician will call you back within one to two business days.";
  });
</script>
