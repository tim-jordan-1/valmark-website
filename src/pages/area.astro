---
import Base from "../layouts/Base.astro";
import ServiceAreaMap from "../components/ServiceAreaMap.astro";
import { cities, site } from "../data/site";
---

<Base title="Service Area — Valmark Waterproofing" activePage="area">
  <!-- Hero -->
  <section class="bg-primary text-white py-10">
    <div class="max-w-[1200px] mx-auto px-6 text-center">
      <p
        class="text-accent-light uppercase tracking-wider font-bold text-sm mb-4"
      >
        Service Area
      </p>
      <h1 class="text-[clamp(34px,4.8vw,52px)] font-black leading-tight mb-6">
        Waterproofing Across Melbourne
      </h1>
      <p class="text-lg leading-relaxed max-w-2xl mx-auto text-gray-300 mb-8">
        We service Melbourne metropolitan area. Check out our service area map
        below to see if we cover your suburb.
      </p>
    </div>
  </section>

  <!-- Content -->
  <section class="py-16">
    <div class="max-w-[1200px] mx-auto px-6 grid lg:grid-cols-2 gap-10">
      <!-- Left: cities -->
      <div>
        <h2 class="text-[clamp(26px,3.5vw,36px)] font-black text-primary mb-6">
          Where We Work
        </h2>
        <div class="flex flex-wrap gap-3 mb-8">
          {
            cities.map((city) => (
              <span class="bg-accent-bg rounded-full px-5 py-[11px] font-semibold text-primary text-sm">
                {city}
              </span>
            ))
          }
        </div>
        <p class="text-text-secondary leading-[1.7]">
          Don't see your suburb? We regularly travel outside these areas. Call
          us on{" "}
          <a href={site.tel} class="text-accent font-bold hover:underline"
            >{site.phone}</a
          >{" "}
          and we'll let you know.
        </p>
      </div>

      <!-- Right: service-area map -->
      <ServiceAreaMap />
    </div>
  </section>
</Base>
