---
import Base from '../layouts/Base.astro';
import { cities, site } from '../data/site';
---

<Base title="Service Area — Valmark Waterproofing" activePage="area">
  <!-- Hero -->
  <section class="bg-primary text-white py-16">
    <div class="max-w-[1200px] mx-auto px-6 text-center">
      <p class="text-accent-light uppercase tracking-wider font-bold text-sm mb-4">Service Area</p>
      <h1 class="text-[clamp(34px,4.8vw,52px)] font-black leading-tight mb-6">Waterproofing Across Victoria</h1>
      <p class="text-lg leading-relaxed max-w-2xl mx-auto text-gray-300 mb-8">We service Melbourne and surrounding regions. Enter your postcode to check if you're in our coverage area.</p>
      <div class="flex items-center justify-center gap-3 flex-wrap">
        <input
          id="postcode-input"
          type="text"
          maxlength={4}
          placeholder="Enter postcode"
          class="bg-white text-primary rounded px-4 py-3 w-40 text-center font-medium"
        />
        <button id="postcode-btn" class="bg-accent text-white rounded px-6 py-3 font-bold cursor-pointer hover:opacity-90 transition-opacity">
          Check coverage
        </button>
      </div>
      <div id="postcode-msg" class="mt-3 text-white font-medium"></div>
    </div>
  </section>

  <!-- Content -->
  <section class="py-16">
    <div class="max-w-[1200px] mx-auto px-6 grid lg:grid-cols-2 gap-10">
      <!-- Left: cities -->
      <div>
        <h2 class="text-[clamp(26px,3.5vw,36px)] font-black text-primary mb-6">Where We Work</h2>
        <div class="flex flex-wrap gap-3 mb-8">
          {cities.map((city) => (
            <span class="bg-accent-bg rounded-full px-5 py-[11px] font-semibold text-primary text-sm">{city}</span>
          ))}
        </div>
        <p class="text-text-secondary leading-[1.7]">
          Don't see your suburb? We regularly travel outside these areas. Call us on
          <a href={site.tel} class="text-accent font-bold hover:underline">{site.phone}</a>
          and we'll let you know.
        </p>
      </div>

      <!-- Right: map placeholder -->
      <div
        class="bg-bg-light border border-border rounded flex items-center justify-center text-text-tertiary text-lg font-medium"
        style="aspect-ratio:4/3;background-image:repeating-linear-gradient(45deg,transparent,transparent 10px,rgba(0,0,0,.03) 10px,rgba(0,0,0,.03) 20px);"
      >
        Map placeholder
      </div>
    </div>
  </section>
</Base>

<script>
  const input = document.getElementById('postcode-input') as HTMLInputElement;
  const btn = document.getElementById('postcode-btn');
  const msg = document.getElementById('postcode-msg');

  input?.addEventListener('input', () => { input.value = input.value.replace(/\D/g, '').slice(0, 4); });

  btn?.addEventListener('click', () => {
    const val = input?.value || '';
    if (!msg) return;
    if (val.length !== 4) { msg.textContent = 'Enter a 4-digit postcode.'; }
    else if (+val % 3 === 0) { msg.textContent = 'Just outside our line — call us, we make exceptions.'; }
    else { msg.textContent = 'Covered — next inspection window in 2 days.'; }
  });
</script>
