---
import { services } from "../data/services";
import { site, navItems } from "../data/site";
---

<footer class="bg-primary text-white pb-[62px] lg:pb-0">
  <div class="max-w-[1200px] mx-auto px-6 py-16">
    <div class="grid grid-cols-[repeat(auto-fit,minmax(180px,1fr))] gap-10">
      <!-- Logo + description -->
      <div>
        <img
          src="/uploads/logo-transparent.png"
          alt="Valmark Waterproofing"
          class="h-[110px] w-auto mb-5"
        />
        <p class="text-sm leading-relaxed text-gray-300">
          Professional waterproofing services across Melbourne and Victoria.
          Protecting homes and buildings with expert membrane systems and
          quality workmanship.
        </p>
      </div>

      <!-- Services links -->
      <div class="lg:col-span-1">
        <h3 class="text-lg font-bold mb-4">Services</h3>
        <div class="grid grid-cols-2 gap-x-4 gap-y-2">
          {
            services.map((s) => (
              <a
                href={`/services/${s.id}`}
                class="text-sm text-gray-300 hover:text-accent transition-colors leading-relaxed"
              >
                {s.name.split(",")[0]}
              </a>
            ))
          }
        </div>
      </div>

      <!-- Company links -->
      <div>
        <h3 class="text-lg font-bold mb-4">Company</h3>
        <div class="flex flex-col gap-2">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class="text-sm text-gray-300 hover:text-accent transition-colors"
              >
                {item.label}
              </a>
            ))
          }
        </div>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-lg font-bold mb-4">Contact</h3>
        <a
          href={site.tel}
          class="block text-xl font-bold mb-3 hover:text-accent transition-colors"
          >{site.phone}</a
        >
        <a
          href={`mailto:${site.email}`}
          class="block text-sm text-gray-300 hover:text-accent transition-colors mb-3"
          >{site.email}</a
        >
        <a href="/contact" class="text-sm text-accent hover:underline"
          >Schedule an inspection →</a
        >
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-white/20">
    <div
      class="max-w-[1200px] mx-auto px-6 py-5 flex flex-wrap justify-between items-center gap-4 text-sm text-gray-400"
    >
      <span>© 2026 Valmark Waterproofing LLC</span>
      <span>{site.license}</span>
    </div>
  </div>
</footer>
