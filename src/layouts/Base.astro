---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBottomBar from '../components/MobileBottomBar.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  activePage?: string;
}

const {
  title = 'Valmark Waterproofing — Melbourne',
  description = 'Melbourne waterproofing specialists — bathrooms, balconies, basements, retaining walls and leak remediation across greater Melbourne. 7-year transferable warranty.',
  activePage = '',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en-AU">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/uploads/logo-transparent.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700;900&display=swap" rel="stylesheet" />
</head>
<body class="font-roboto text-base text-text-main bg-white">
  <Header activePage={activePage} />
  <main>
    <slot />
  </main>
  <Footer />
  <MobileBottomBar />
</body>
</html>
